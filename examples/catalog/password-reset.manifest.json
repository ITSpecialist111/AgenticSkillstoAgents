{
  "apiVersion": "skills.dev/v1",
  "kind": "Skill",
  "identity": {
    "id": "it/password-reset",
    "name": "Self-Service Password Reset",
    "version": "2.0.1",
    "description": "Initiates a verified self-service password reset and emits a one-time reset link to the user's registered channel.",
    "owner": {
      "handle": "i.tomas",
      "team": "IT Service Desk"
    },
    "skillType": "deterministic-tool",
    "tags": [
      "it",
      "identity",
      "self-service"
    ]
  },
  "capability": {
    "summary": "Initiate a verified self-service password reset",
    "capabilityTags": [
      "it.password.reset"
    ],
    "inputs": [
      {
        "name": "userId",
        "type": "UserId",
        "required": true
      },
      {
        "name": "channel",
        "type": "ContactChannel",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "resetTicket",
        "type": "ResetTicket",
        "required": true
      }
    ],
    "preconditions": [
      "user.authenticated",
      "mfa.verified"
    ],
    "effects": [
      "credential.reset.requested"
    ]
  },
  "scoring": {
    "determinism": "high",
    "risk": "medium",
    "reversible": false,
    "rationale": "Triggers a credential workflow (irreversible link issuance); medium risk, MFA-gated."
  },
  "dependencies": [],
  "governance": {
    "visibility": "org",
    "rbac": [
      "it.helpdesk"
    ],
    "dataClassification": "confidential",
    "cost": {
      "unit": "usd-per-1k-calls",
      "estimate": 0.3
    },
    "audit": {
      "logged": true,
      "retentionDays": 365
    }
  },
  "lifecycle": {
    "stage": "published",
    "certifiedBy": "coe.reviewer",
    "certifiedAt": "2026-06-01T09:00:00Z"
  }
}
